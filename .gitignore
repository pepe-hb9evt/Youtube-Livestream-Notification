# Ignore everything (/*) except the project files (allow-list with !/... ).
# This keeps the real configuration (channels.json, settings.json, secrets.json
# with the SMTP password), the state and the log out of Git.

# Ignore everything ...
/*

# ... except this white list:
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/README_deutsch_german.md
!/ut-livestream-monitor.py
!/Menu for ut-livestream-monitor-py.bat
!/install_task.ps1
!/Research_How-to-dedect-status-of-Youtube-livestreams.md

# config folder: only the example files
!/config/
/config/*
!/config/*.example.json

# Python
__pycache__/
*.pyc
